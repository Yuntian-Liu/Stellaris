# ===== Stellaris 环境变量配置 =====
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# 小米 Mimo ASR（必需）
MIMO_API_KEY=sk-your-mimo-api-key-here

# DeepSeek LLM（必需，用于 TXT 语义分段 + Markdown 转写）
# 申请地址：https://platform.deepseek.com/
# LLM_BASE_URL / LLM_MODEL 填你实际使用的 OpenAI 兼容接口和模型名
LLM_API_KEY=sk-your-llm-api-key-here
LLM_BASE_URL=https://your-llm-base-url/v1
LLM_MODEL=your-llm-model-name

# B站 SESSDATA（可选，用于获取 CC 字幕）
# 获取方式：浏览器 F12 → Console → document.cookie → 找 SESSDATA 值
BILIBILI_SESSDATA=

# ===== 用户系统 Auth =====
# Cloudflare Turnstile 人机验证（申请：https://dash.cloudflare.com/?to=/:account/turnstile）
# Site Key 给前端,Secret Key 留后端
TURNSTILE_SITE_KEY=0x-your-turnstile-site-key
TURNSTILE_SECRET_KEY=0x-your-turnstile-secret-key

# Resend 邮件（验证码发送,申请：https://resend.com）
# 域名需先在 Resend 后台完成 SPF/DKIM 验证才能发信
RESEND_API_KEY=re-your-resend-api-key
RESEND_FROM=Stellaris <noreply@your-domain.com>

# JWT 密钥（生产必须改成随机串,生成命令:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"）
JWT_SECRET=change-me-to-random-48char-string

# 运行环境（true = 真实发信 + Turnstile 真校验；false = 开发 bypass + 验证码打印日志）
IS_PROD=false
